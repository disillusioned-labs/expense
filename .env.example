# Every setting the app reads, written exactly as a deployment sets it.
#
#   cp .env.example .env      # local development; .env is git-ignored
#
# The values here are the LOCAL DEVELOPMENT set. The built-in defaults
# (internal/config) are the production-safe set, so a container that ships no
# file and sets only what it needs is already sane: JSON logs at info, no
# boot-time migrations, pprof off.
#
# Precedence: real environment variable > .env > built-in default.
# Every value is validated at boot; a bad one fails fast and reports every
# problem at once rather than degrading silently.
#
# Names are unprefixed, so they share a namespace with everything else in the
# environment. SERVICE_* is named defensively because bare NAME and ENV are too
# generic; OTEL_* does the opposite on purpose and adopts the OpenTelemetry
# SDK's own names, so the SDK and this app cannot disagree about them. When
# adding a key, check the name against what an orchestrator might inject -
# Kubernetes sets <SERVICE>_PORT and <SERVICE>_SERVICE_HOST for every Service
# in the namespace, so avoid names like POSTGRES_PORT or REDIS_PORT.

# --- service ---------------------------------------------------------------
# SERVICE_ENV: development | staging | production
SERVICE_NAME=expense
SERVICE_ENV=development

# --- server ----------------------------------------------------------------
# 8081 so it runs alongside identity (8080).
SERVER_PORT=8081
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=20s
# Per-request context deadline. Validated to stay below WRITE_TIMEOUT so the
# resulting 504 can still be written to the client.
SERVER_REQUEST_TIMEOUT=20s
# How long /readyz reports 503 before draining starts, giving an orchestrator
# time to pull this instance out of rotation. 0 disables the wait.
SERVER_DRAIN_DELAY=5s

# --- pprof -----------------------------------------------------------------
# Profiling listener, off by default. Flip ENABLED to true when you need it;
# nothing is created while it is off (no socket, no goroutine).
PPROF_ENABLED=false
PPROF_PORT=6061

# --- postgres --------------------------------------------------------------
# Database created by scripts/init-db.sql (workspace root) together with the
# expense_app role. Postgres runs natively on this machine; only the infra
# stacks are containerised (see ../infra).
POSTGRES_DSN=postgres://expense_app:devpassword@localhost:5432/expense?sslmode=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
# Apply embedded goose migrations at boot. Convenient locally; defaults to
# false, so a production image never migrates unless asked.
POSTGRES_MIGRATE=true
POSTGRES_QUERY_EXEC_MODE=cache_statement

# --- redis -----------------------------------------------------------------
# expense has no cache use yet, so disabled is the honest default. The key set
# matches identity so enabling later needs no new vocabulary:
# disabled = no redis, no caching
# optional = degrade gracefully: warn and run uncached when unreachable
# required = fail-fast at startup when unreachable
REDIS_MODE=disabled
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- cache -----------------------------------------------------------------
CACHE_DEFAULT_TTL=5m

# --- kafka -----------------------------------------------------------------
# Producer only (outbox publisher, M4). 19092 is the external listener of the
# messaging stack (../infra/messaging).
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=expense
KAFKA_PING_TIMEOUT=5s
KAFKA_PRODUCER_RECORD_RETRIES=5
KAFKA_PRODUCER_RECORD_DELIVERY_TIMEOUT=30s

# --- opentelemetry ---------------------------------------------------------
# Traces AND metrics are PUSHED over OTLP/gRPC to a collector. This app serves
# no /metrics endpoint - nothing is readable without a reachable collector.
#
# OTEL_SERVICE_NAME is NOT read: SERVICE_NAME above owns the service identity,
# because the logger uses it too. Variables not listed here still reach the
# exporter when set as REAL environment variables (OTEL_EXPORTER_OTLP_HEADERS,
# _TIMEOUT, _COMPRESSION): the SDK reads those itself.
#
# Turn everything off with OTEL_SDK_DISABLED=true, or one signal with
# OTEL_TRACES_EXPORTER=none / OTEL_METRICS_EXPORTER=none.
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
# The scheme is required and selects transport security: http:// is plaintext,
# https:// is TLS. A bare host:port is rejected at boot.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# always_on | always_off | traceidratio | parentbased_always_on |
# parentbased_always_off | parentbased_traceidratio
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# MILLISECONDS, per the OTel spec - not a Go duration like the timeouts above.
OTEL_METRIC_EXPORT_INTERVAL=15000

# --- log -------------------------------------------------------------------
# level: debug | info | warn | error      format: text | json
LOG_LEVEL=debug
LOG_FORMAT=text

# --- ratelimit ---------------------------------------------------------------
RATELIMIT_ENABLED=true
# Requests allowed per IP per window. Counted in-process: N replicas allow
# N*requests. Use a shared store (httprate-redis) for a hard global cap.
RATELIMIT_REQUESTS=40
RATELIMIT_WINDOW=1s
