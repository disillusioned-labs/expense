# Docker Compose overrides.
#
# Base configuration comes from .env.
# This file only changes addresses that must resolve through the
# Docker Compose networks instead of localhost.

# --- postgres --------------------------------------------------------------
POSTGRES_DSN=postgres://expense_app:devpassword@data-postgres:5432/expense?sslmode=disable

# --- redis -----------------------------------------------------------------
REDIS_ADDR=data-redis:6379

# --- kafka -----------------------------------------------------------------
KAFKA_BROKERS=messaging-kafka:9092

# --- opentelemetry ---------------------------------------------------------
# The API container reaches the OTel Collector through the shared
# observability Docker network using the collector service name.

OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-otel-collector:4317

# --- grpc -------------------------------------------------------------------
# Targets resolve through the shared Docker networks (container DNS), so they
# name containers, not localhost. The OCR entry points at the gateway's
# planned container; an unreachable gateway must not fail an upload - it only
# keeps documents pending OCR.

IDENTITY_GRPC_TARGET=identity-grpc:9090
OCR_GATEWAY_TARGET=ocr-gateway-grpc:9093
